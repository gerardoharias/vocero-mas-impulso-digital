{
  "name": "vocero-crm",
  "version": "1.3.0",
  "description": "CRM de WhatsApp open source y self-hosted con agente de IA y Laboratorio de auto-evaluación",
  "license": "MIT",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts",
    "test:e2e": "node --env-file=.env scripts/e2e-selftest.mjs",
    "test:ai-live": "node --env-file-if-exists=.env.live node_modules/vitest/vitest.mjs run --config vitest.live.config.ts ai-real",
    "test:ai-live-profile-check": "tsx tests/live/validate-profile-cli.ts",
    "test:ai-live-025": "node --env-file=.env --env-file-if-exists=.env.live node_modules/vitest/vitest.mjs run --config vitest.live.config.ts availability-live",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "seed:demo": "esbuild scripts/seed/demo.ts --bundle --platform=node --format=esm --outfile=.tmp-seed-demo.mjs --alias:@=./src --packages=external && node .tmp-seed-demo.mjs",
    "seed:mas-impulso": "esbuild scripts/seed/mas-impulso.ts --bundle --platform=node --format=esm --outfile=.tmp-seed-mas-impulso.mjs --alias:@=./src --packages=external && node .tmp-seed-mas-impulso.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "better-auth": "^1.1.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.469.0",
    "nanoid": "^5.0.9",
    "next": "^15.5.25",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@next/eslint-plugin-next": "^15.5.20",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.25.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.25",
    "eslint-plugin-react-hooks": "^5.2.0",
    "playwright": "^1.61.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  }
}
